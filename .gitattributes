# 统一换行符，避免 Windows 下 CRLF 污染仓库
* text=auto eol=lf

# 明确文本类型
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf

# 二进制资源不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
